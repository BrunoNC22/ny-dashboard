# Copie para .env e ajuste. Valores padrão pensados para desenvolvimento local.

# PostgreSQL (usado pelo docker compose e pela api)
POSTGRES_USER=ny
POSTGRES_PASSWORD=ny
POSTGRES_DB=ny_dashboard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ny:ny@localhost:5432/ny_dashboard

# API
API_PORT=3000
# No docker compose, este valor de exemplo (ou vazio) faz a api gerar um segredo aleatório e
# guardá-lo no volume api-secrets. Em `pnpm dev` (fora de produção) ele é aceito.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Só envia o cookie de sessão por HTTPS. Mantenha false para http://localhost.
COOKIE_SECURE=false

# Web (porta publicada pelo docker compose)
WEB_PORT=8080

# Seed no docker compose: --if-empty (padrão; só carrega se o snapshot ainda não estiver no
# banco) ou --force (sempre recarrega)
# SEED_FLAGS=--if-empty
