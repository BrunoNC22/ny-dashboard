# Copie para .env e ajuste. Valores padrão pensados para desenvolvimento local.

# PostgreSQL (usado pelo docker compose e pela api)
POSTGRES_USER=ny
POSTGRES_PASSWORD=ny
POSTGRES_DB=ny_dashboard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ny:ny@localhost:5432/ny_dashboard

# API
API_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Web
WEB_PORT=8080
