{
  "name": "@ny-dashboard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "etl:zones": "tsx etl/zones.ts",
    "etl": "tsx etl/index.ts",
    "etl:snapshot": "tsx etl/snapshot.ts"
  },
  "dependencies": {
    "@ny-dashboard/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "mapshaper": "0.7.101",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
